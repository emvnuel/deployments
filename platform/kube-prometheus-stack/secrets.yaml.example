# Exemplo do Secret de configuração do Alertmanager (Telegram).
#
# Copie para `secrets.yaml` NA MESMA PASTA (gitignored pelo padrão `secrets.yaml`
# no .gitignore raiz), preencha e aplique:
#
#   cp secrets.yaml.example secrets.yaml
#   $EDITOR secrets.yaml
#   kubectl apply -f platform/kube-prometheus-stack/secrets.yaml
#
# O values.yaml referencia este Secret via
# `alertmanager.alertmanagerSpec.configSecret: alertmanager-telegram-config`
# com `useExistingSecret: true` — o chart não gera mais o secret.
#
# Bot: reaproveitamos o bot do Hermes (`TELEGRAM_BOT_TOKEN` em
# hermes-agent/hermes-agent-secrets); o chat_id é o id do usuário autorizado
# (`TELEGRAM_ALLOWED_USERS`), porque em chat privado chat_id == user_id.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-telegram-config
  namespace: monitoring
  labels:
    app.kubernetes.io/part-of: kube-prometheus-stack
type: Opaque
stringData:
  alertmanager.yaml: |
    global:
      resolve_timeout: 5m
    route:
      group_by: ["alertname", "namespace"]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      receiver: telegram
      routes:
        - matchers: ['alertname="Watchdog"']
          receiver: "null"
    receivers:
      - name: telegram
        telegram_configs:
          - bot_token: "<TELEGRAM_BOT_TOKEN>"
            chat_id: <TELEGRAM_CHAT_ID>
            parse_mode: HTML
            send_resolved: true
      - name: "null"
